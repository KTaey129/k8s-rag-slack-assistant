# Copy to .env and fill in. Never commit the real .env.

# --- LLM ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Slack (create an app at https://api.slack.com/apps) ---
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=

# --- Internal auth between n8n and FastAPI ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_SHARED_SECRET=

# --- Infra (defaults match docker-compose service names; override for local-without-docker dev) ---
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=k8s_docs

# --- RAG tuning ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RETRIEVAL_TOP_K=5
CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=200
DOCS_DIR=data/k8s-docs
